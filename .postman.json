                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client_id\": \"1\",\n  \"storage_model_id\": \"1\",\n  \"failure_type\": \"logical\",\n  \"failure_description\": \"Device not recognized\",\n  \"stage\": \"received\",\n  \"status\": \"received\",\n  \"customFields\": {\n    \"field_1\": \"test_value\",\n    \"field_2\": \"another_value\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cases",
              "host": ["{{baseUrl}}"],
              "path": ["api", "cases"]
            },
            "description": "Create a case with custom fields. The endpoint should validate that custom field IDs exist before saving."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 200\", function () {",
                  "    pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
