# ============================================================
# RecoverLab CRM — Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development
LOG_LEVEL=info

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=recoverlab_crm
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_POOL_MIN=2
DB_POOL_MAX=20

# Database Migrations
# Set to 'false' to skip migration checks (useful in production when DB is already set up)
RUN_MIGRATIONS=true

# JWT
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_SECRET_KEY_HERE
JWT_EXPIRES_IN=8h

# CORS
FRONTEND_URL=http://localhost:5174

# File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=104857600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10

# ============================================================
# Security & Encryption (CRITICAL FOR PRODUCTION)
# ============================================================

# Encryption Key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# MUST be exactly 64 hexadecimal characters (32 bytes)
ENCRYPTION_KEY=your_64_char_hex_key_here

# Secure Cookie Configuration
# Domain for cookies (leave empty for current domain, set to production domain)
SECURE_COOKIE_DOMAIN=yourdomain.com

# SameSite cookie policy (Strict, Lax, or None)
SECURE_COOKIE_SAME_SITE=Strict

# Refresh Token Expiry (in days)
REFRESH_TOKEN_EXPIRY_DAYS=30

# Password Reset Token Expiry (in minutes)
PASSWORD_RESET_EXPIRY_MINS=60

# Production Security Flags
# Set to 'true' in production to enforce strict validation
FORCE_SECURE_COOKIES=false
VALIDATE_JWT_SECRET=false
