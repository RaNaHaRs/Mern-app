{
  "enabled": true,
  "name": "API Postman Testing",
  "description": "Monitors API source code changes and automatically validates API functionality with Postman collection tests",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "backend/src/routes/**/*.js",
      "backend/src/services/**/*.js",
      "backend/src/middleware/**/*.js",
      "backend/package.json"
    ]
  },
  "then": {
    "type": "askAgent",
    "prompt": "API source code has been modified in {{changes}}. Run the Postman collection to validate the API functionality. Retrieve the .postman.json file, run the collection tests, and report which tests passed/failed. For any failures, analyze the error and propose specific fixes to the source code."
  }
}